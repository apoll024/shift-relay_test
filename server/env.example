SHIFT_RELAY_TIMEZONE=America/Los_Angeles
SHIFT_RELAY_ORIGINS=http://localhost:8081,http://localhost:8181
# Production example: https://relay.example.org
# SMTP credentials are server-only; never use EXPO_PUBLIC_ for secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
